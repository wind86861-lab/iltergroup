DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
PORT=3001
# Comma-separated origins allowed by CORS (production: "https://iltergroup.uz,https://www.iltergroup.uz")
FRONTEND_URL="http://localhost:5173"
# Interface the API listens on. Keep 127.0.0.1 in production: only nginx should reach it.
HOST="127.0.0.1"

# Telegram notifications (token from @BotFather, chat ID from the group)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
